
def pad(data, chunksize):
    pad_size = len(data) % chunksize
    if pad_size > 0:
        pad_size = chunksize - (len(data) % chunksize)

    return data + b"\x04" * pad_size


chunksize = 20
plaintext = b"YELLOW SUBMARINE"

ret = pad(plaintext, chunksize)
print(f"Plaintext {plaintext} - {len(plaintext)}")
print(f"Padded {ret} - {len(ret)}")
