import string
import base64
import time


def count_repetitions(data, chunksize = 16):

    chunks = [data[idx:idx+chunksize] for idx in range(0, len(data), chunksize)]
    nb_rep = max([chunks.count(chunk) for chunk in chunks])
    return nb_rep


with open("8-file", "r") as f:

    lines = f.readlines()
    max_rep = 0
    line_rep = ""
    idx_rep = 0
    idx = 0

    for line in lines:
        ciphertext = bytes.fromhex(line)
        nb_rep = count_repetitions(ciphertext)

        if nb_rep > max_rep:
            max_rep = nb_rep
