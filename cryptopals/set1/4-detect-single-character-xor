import string

def sounds_english(txt):
    #result = len([c for c in txt if chr(c) in string.ascii_letters]) / len(txt)
    result = len([c for c in txt if chr(c) in string.ascii_lowercase]) / len(txt)
    #return result
    return result > 0.7


def xor(txt, key):
    result = bytearray()

    for i in range(len(txt)):
        x = txt[i] ^ key
        result.append(x)

    return bytes(result)


with open("4-file", "r") as f:

    lines = f.readlines()

    for line in lines:
        txt = bytes.fromhex(line)
        #print(f"{line} - {txt}")

        for i in range(256):
            result = xor(txt, i)
            is_english = sounds_english(result)
            #if is_english > 0.7:
            #    print(f"{is_english} - {result}")

            if is_english:
                print(f"{line.strip()} - {i} - {result}")
