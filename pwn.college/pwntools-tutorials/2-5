from pwn import *

context(arch="amd64", os="linux", log_level="info")

p = process("/challenge/pwntools-tutorials-level2.5")

#* the top value of the stack = abs(the top value of the stack)


payload = asm("""
mov rax, [rsp]
mov rbx, rax
sar rbx, 63
xor rax, rbx
sub rax, rbx
mov [rsp], rax
""")

p.readuntil(b"Please give me your assembly")
p.readline()

p.send(payload)

while True:
    try:
        line = p.recvline()
        success(line.decode())
    except EOFError:
        break
