from pwn import *

context(arch="amd64", os="linux", log_level="info")

p = process("/challenge/pwntools-tutorials-level2.2")

#rax = rax % rbx + rcx - rsi
payload = asm("""
div rbx
mov rax, rdx
add rax, rcx
sub rax, rsi
""")

p.readuntil(b"Please give me your assembly")
p.readline()

p.send(payload)

while True:
    try:
        line = p.recvline()
        success(line.decode())
    except EOFError:
        break
