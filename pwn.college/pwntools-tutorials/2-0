from pwn import *

context(arch="amd64", os="linux", log_level="info")

p = process("/challenge/pwntools-tutorials-level2.0")


payload = asm("mov rax, 0x12345678")

p.readuntil(b"Please give me your assembly")
p.readline()

p.send(payload)

while True:
    try:
        line = p.recvline()
        success(line.decode())
    except EOFError:
        break

