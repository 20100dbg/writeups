import socket
import threading
import time


HOST = "10.0.0.2"  # The server's hostname or IP address
PORT = 31337       # The port used by the server


def start_client():

    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.connect((HOST, PORT))
    time.sleep(10)


for i in range(100):
    print(f"\rOpened {i+1} sockets", end="") 
    t = threading.Thread(target=start_client,args=[])
    t.start()
