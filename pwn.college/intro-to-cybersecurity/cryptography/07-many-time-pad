from pwn import *
from Crypto.Util.strxor import strxor


def xor(b1, b2):
   return bytes([_a ^ _b for _a,_b in zip(b1,b2)])

p = process('/challenge/run')

flag_cipher = p.readline().decode()
flag_cipher = flag_cipher.split(':')[1].strip()
flag_cipher = bytes.fromhex(flag_cipher)

print(f"flag   : {flag_cipher.hex()}")

max_len = len(flag_cipher)


plain = b"a" * max_len
print(f"plain  : {plain.hex()}")
p.write(plain.hex().encode() + b"\n")

cipher = p.readline()[35:].decode().strip()
cipher = bytes.fromhex(cipher)
print(f"cipher : {cipher.hex()}")

key = xor(cipher, plain)
print(f"key    : {key.hex()}")

flag_plain = xor(flag_cipher, key)
print(f"flag   : {flag_plain.decode()}")
